<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- ========================================================= -->
    <!-- AutoMapper                                                -->
    <!-- ========================================================= -->
    <PackageVersion Include="AutoMapper" Version="15.1.1" />
    <!-- ========================================================= -->
    <!-- MediatR                                                    -->
    <!-- ========================================================= -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.1" />
    <PackageVersion Include="MediatR" Version="13.1.0" />
    <!-- ========================================================= -->
    <!-- FluentValidation                                           -->
    <!-- ========================================================= -->
    <PackageVersion Include="FluentValidation" Version="12.1.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <!-- ========================================================= -->
    <!-- ASP.NET Core                                                -->
    <!-- ========================================================= -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- ========================================================= -->
    <!-- Microsoft Extensions                                        -->
    <!-- ========================================================= -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- ========================================================= -->
    <!-- Entity Framework Core                                       -->
    <!-- ========================================================= -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.4" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- ========================================================= -->
    <!-- API Versioning                                              -->
    <!-- ========================================================= -->
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.0" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <!-- ========================================================= -->
    <!-- OpenAPI / Swagger                                           -->
    <!-- ========================================================= -->
    <!-- Explicitly pin Microsoft.OpenApi to avoid vulnerable 2.0.0 -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- ========================================================= -->
    <!-- Logging                                                     -->
    <!-- ========================================================= -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- ========================================================= -->
    <!-- Hangfire                                                    -->
    <!-- ========================================================= -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- ========================================================= -->
    <!-- Firebase                                                    -->
    <!-- ========================================================= -->
    <PackageVersion Include="FirebaseAdmin" Version="3.4.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.70.0" />
    <!-- ========================================================= -->
    <!-- Email                                                       -->
    <!-- ========================================================= -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <!-- ========================================================= -->
    <!-- Security                                                    -->
    <!-- ========================================================= -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- ========================================================= -->
    <!-- Testing                                                     -->
    <!-- ========================================================= -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
  </ItemGroup>
</Project>